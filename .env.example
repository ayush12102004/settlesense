# SettleSense Configuration

# 1. Google Gemini (Recommended - Generous Free Tier, no credit card required)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=
# or GOOGLE_API_KEY=

# Optional Gemini model override (defaults to gemini-2.5-flash)
APP_GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI (Alternative)
OPENAI_API_KEY=
APP_OPENAI_MODEL=gpt-4o-mini

# 3. Offline Mode
# Set to 1 to force the deterministic heuristic mock model even if API keys are present
APP_USE_MOCK=0
