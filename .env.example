# 1. Groq (Recommended - Ultra Low Latency LPUs)
# Get a key at: https://console.groq.com/
GROQ_API_KEY=
APP_GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=groq

# 2. Google Gemini (Alternative)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=
APP_GEMINI_MODEL=gemini-3.1-flash-lite

# 2. OpenAI (Alternative)
OPENAI_API_KEY=
APP_OPENAI_MODEL=gpt-4o-mini

# 3. Offline Mode
# Set to 1 to force the deterministic heuristic mock model even if API keys are present
APP_USE_MOCK=0
